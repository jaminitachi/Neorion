{
  "name": "neorion",
  "displayName": "Neorion",
  "publisher": "neOriOn",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaminitachi/Neorion"
  },
  "description": "Optimizes codebase context for LLM coding tools by generating an architectural graph.",
  "version": "0.2.2",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:neo.generateGraph",
    "onCommand:neo.showGraph"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "neo.generateGraph",
        "title": "Neorion: Generate Architecture Map"
      },
      {
        "command": "neo.showGraph",
        "title": "Neorion: Show Architecture Graph (Beta)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "neo-arch-explorer",
          "title": "Neorion",
          "icon": "resources/icon.png"
        }
      ]
    },
    "views": {
      "neo-arch-explorer": [
        {
          "id": "neoArchView",
          "name": "Architecture Map",
          "icon": "resources/icon.png"
        }
      ]
    }
  },
  "icon": "resources/icon.png",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc --noEmit && npm run bundle",
    "watch": "npm run bundle -- --watch",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --target=node16 --external:vscode --minify --legal-comments=external --outfile=out/extension.js",
    "test": "node --test test/graph.test.cjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "ts-morph": "^21.0.1",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}

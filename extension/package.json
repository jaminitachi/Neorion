{
  "name": "neorion",
  "displayName": "Neorion",
  "publisher": "neOriOn",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaminitachi/Neorion"
  },
  "description": "Optimizes codebase context for LLM coding tools by generating an architectural graph.",
  "version": "0.6.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:neo.generateGraph",
    "onCommand:neo.showGraph",
    "onCommand:neo.connectAITools",
    "onCommand:neo.disconnectAITools"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "neo.generateGraph",
        "title": "Neorion: Generate Architecture Map"
      },
      {
        "command": "neo.showGraph",
        "title": "Neorion: Show Architecture Graph (Beta)"
      },
      {
        "command": "neo.connectAITools",
        "title": "Neorion: Connect AI tools"
      },
      {
        "command": "neo.disconnectAITools",
        "title": "Neorion: Disconnect AI tools"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "neo-arch-explorer",
          "title": "Neorion",
          "icon": "resources/icon.png"
        }
      ]
    },
    "views": {
      "neo-arch-explorer": [
        {
          "id": "neoArchView",
          "name": "Architecture Map",
          "icon": "resources/icon.png"
        }
      ]
    }
  },
  "icon": "resources/icon.png",
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run check:notices",
    "compile": "tsc --noEmit && npm run bundle",
    "watch": "npm run bundle -- --watch",
    "bundle": "node test/bundle.cjs",
    "test": "node test/run-tests.cjs",
    "check:notices": "node test/check-notices.cjs",
    "build:cli": "tsc --noEmit && node test/bundle.cjs --cli && npm run check:notices -- --cli",
    "pack:cli": "npm pack ../neorion"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "^20.0.0",
    "@types/semver": "^7.8.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "4.1.1",
    "cross-spawn": "7.0.6",
    "esbuild": "0.28.2",
    "js-tiktoken": "1.0.21",
    "jsonc-parser": "3.3.1",
    "semver": "^7.8.6",
    "ts-morph": "21.0.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "11.0.9"
    }
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.1.1": true,
    "esbuild@0.28.2": true
  },
  "license": "MIT"
}
